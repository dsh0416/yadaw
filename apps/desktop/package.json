{
  "name": "@heron/desktop",
  "version": "0.4.3",
  "description": "A browser-technology digital audio workstation with a Rust DSP core.",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "vite build --config vite.main.config.ts && node scripts/verify-project-template.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts && node scripts/verify-renderer-security.ts",
    "check": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test:unit": "vitest run",
    "test:coverage": "node ../../scripts/run-vitest-coverage.ts",
    "test:vst3-runtime": "node scripts/vst3-runtime-smoke.ts",
    "test:clap-runtime": "node scripts/clap-runtime-smoke.ts",
    "test:vst3-editor": "node scripts/vst3-editor-smoke-launch.ts",
    "test:builtin-vst3": "node scripts/builtin-vst3-smoke.ts && node scripts/audio-benchmark-smoke.ts",
    "verify:package-security": "node scripts/verify-electron-security.ts",
    "test:e2e": "pnpm build && playwright test",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@electric-sql/pglite": "catalog:",
    "@heron/dsp-node": "workspace:*",
    "@heron/project-db": "workspace:*",
    "@heron/project-model": "workspace:*",
    "@heron/ui": "workspace:*",
    "@lucide/vue": "^1.30.0",
    "@msgpack/msgpack": "3.1.3",
    "dompurify": "3.4.13",
    "echarts": "^6.1.0",
    "marked": "18.0.9",
    "vue-i18n": "^11.4.8"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@fontsource-variable/cascadia-mono": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/noto-sans-sc": "catalog:",
    "@fontsource/barlow-condensed": "catalog:",
    "@heron/contracts": "workspace:*",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@pinia/testing": "2.0.1",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@unhead/vue": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vueuse/core": "^14.4.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "catalog:",
    "pinia": "catalog:",
    "typescript": "catalog:",
    "unplugin-fonts": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "^5.2.0",
    "vue-tsc": "catalog:"
  }
}
