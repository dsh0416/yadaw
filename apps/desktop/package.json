{
  "name": "@yadaw/desktop",
  "version": "0.2.1",
  "description": "A browser-technology digital audio workstation with a Rust DSP core.",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "pnpm --filter @yadaw/dsp-node build:debug && pnpm --filter @yadaw/audio-host-client build:debug && cargo build -p yadaw-audio-host && cargo build -p yadaw-vst3-host --bin yadaw-vst3-probe && cargo truce build --vst3 --debug",
    "dev": "node scripts/dev.ts",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "check": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:vst3-helper": "node scripts/vst3-helper-smoke.ts",
    "test:vst3-editor": "node scripts/vst3-editor-smoke.ts",
    "test:builtin-vst3": "node scripts/builtin-vst3-smoke.ts && node scripts/audio-benchmark-smoke.ts",
    "test:ipc": "node scripts/ipc-smoke.ts",
    "test:e2e": "pnpm predev && pnpm build && playwright test",
    "pack": "pnpm --workspace-root build:native && pnpm build && electron-builder --dir --publish never",
    "dist": "pnpm --workspace-root build:native && pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@lucide/vue": "^1.28.0",
    "@msgpack/msgpack": "3.1.3",
    "@yadaw/audio-host-client": "workspace:*",
    "@yadaw/dsp-node": "workspace:*",
    "@yadaw/project-db": "workspace:*",
    "@yadaw/project-model": "workspace:*",
    "@yadaw/ui": "workspace:*",
    "echarts": "^6.1.0",
    "vue-i18n": "^11.4.8"
  },
  "devDependencies": {
    "@fontsource-variable/cascadia-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@pinia/testing": "2.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.1.2",
    "@unhead/vue": "^3.2.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "@vueuse/core": "^14.4.0",
    "@yadaw/contracts": "workspace:*",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "20.11.1",
    "pinia": "^4.0.2",
    "typescript": "^5.9.3",
    "unplugin-fonts": "^2.0.0",
    "vite": "^8.2.0",
    "vitest": "4.1.10",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.9"
  }
}
