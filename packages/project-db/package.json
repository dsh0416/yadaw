{
  "name": "@yadaw/project-db",
  "version": "0.1.2",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": "./src/schema.ts",
    "./protocol": "./src/protocol.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && pnpm db:check",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "bench": "vitest bench --run",
    "test": "vitest run",
    "test:integration": "vitest run src/__tests__"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@yadaw/contracts": "workspace:*",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "drizzle-kit": "0.31.10",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  }
}
