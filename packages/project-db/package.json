{
  "name": "@heron/project-db",
  "version": "0.2.2",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": "./src/schema.ts",
    "./protocol": "./src/protocol.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && pnpm db:check",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "bench": "vitest bench --run",
    "test": "vitest run",
    "test:integration": "vitest run src/__tests__",
    "test:coverage": "vitest run --coverage src/__tests__"
  },
  "dependencies": {
    "@electric-sql/pglite": "catalog:",
    "@heron/contracts": "workspace:*",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "0.31.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
